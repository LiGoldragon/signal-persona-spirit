{
  Magnitude (ImportAll schemas/signal-sema/magnitude.schema)
  SemaSet (Import schemas/signal-sema/sema.schema [SemaOperation SemaOutcome SemaObservation])
}

[
  (State (Statement))
  (Record (Entry))
  (Observe (Observation))
  (Watch (Subscription))
  (Unwatch (SubscriptionToken))
  (Remove (RecordIdentifier))
  (ChangeCertainty (CertaintyChange))
  (CollectRemovalCandidates (RemovalCandidateCollection))
]

[]

[]

{
  State ((Statement))
  Record ((Entry))
  Observe ((Observation))
  Watch ((Subscription))
  Unwatch ((SubscriptionToken))
  Remove ((RecordIdentifier))
  ChangeCertainty ((CertaintyChange))
  CollectRemovalCandidates ((RemovalCandidateCollection))

  Kind (Decision Principle Correction Clarification Constraint)
  ObservationMode (SummaryOnly DescriptionOnly WithProvenance)
  Certainty Magnitude
  Privacy Magnitude
  Mode ObservationMode

  Topic [String]
  Topics [(Vec Topic)]
  MatchKind (Any Partial Full)
  TopicSelection [MatchKind (Vec Topic)]
  CertaintySelection (Any (Exact Certainty) (AtMost Certainty) (AtLeast Certainty))
  PrivacySelection (Any (Exact Privacy) (AtMost Privacy) (AtLeast Privacy))
  Description [String]
  StatementText [String]
  FocusArea [String]
  ArchivePath [String]
  QuestionIdentifier [String]
  QuestionText [String]
  RecordIdentifier [u64]
  RecordIdentifierSelection ((Exact RecordIdentifier))
  RecordIdentifierQuery [RecordIdentifierSelection Mode]
  RecordedTime [Date Time]
  RecordedTimeRange [RecordedTime RecordedTime]
  RecordedTimeSelection (Any (Between RecordedTimeRange) (Since RecordedTime) (Until RecordedTime) Recent Shallow Deep VeryDeep)
  StateSubscriptionToken [u64]
  RecordSubscriptionToken [u64]

  Entry [Topics Kind Description Certainty Privacy]
  CertaintyChange [RecordIdentifier Certainty]
  Statement [StatementText]
  PublicRecordQuery [TopicSelection (Option Kind) CertaintySelection RecordedTimeSelection Mode]
  RecordQuery [TopicSelection (Option Kind) CertaintySelection RecordedTimeSelection PrivacySelection Mode]
  PrivacyScopedRecordQuery [PrivacySelection PublicRecordQuery]
  RecordObservation [RecordQuery]
  OutputStream (StandardOutput StandardError)
  ArchiveDatabaseTarget (Default (Path ArchivePath))
  OutputTarget ((ArchiveDatabase ArchiveDatabaseTarget) (Print OutputStream))
  RemovalCandidateCollection [RecordQuery OutputTarget]
  RecordSubscription [(Option Topic) Mode]
  PrivacyScopedRecordSubscription [PrivacySelection RecordSubscription]
  RecordSummary [RecordIdentifier Topics Kind Description Certainty Privacy]
  RecordProvenance [RecordSummary Date Time]
  RemovalCandidateSkipReason (ArchiveFailed RecordChanged RecordAlreadyRemoved NoLongerCandidate)
  SkippedRemovalCandidate [RecordIdentifier RemovalCandidateSkipReason]
  RemovalCandidatesCollected [(Vec RecordSummary) (Vec RecordIdentifier) (Vec SkippedRemovalCandidate)]
  TopicCount [Topic u64]
  PresenceView [Presence (Option FocusArea)]
  QuestionSummary [QuestionIdentifier QuestionText]
  RecordAccepted [RecordIdentifier]
  RecordRemoved [RecordIdentifier]
  CertaintyChanged [RecordIdentifier Certainty]
  StateObserved [PresenceView]
  RecordsObserved [(Vec RecordSummary)]
  RecordProvenancesObserved [(Vec RecordProvenance)]
  TopicsObserved [(Vec TopicCount)]
  QuestionsObserved [(Vec QuestionSummary)]
  SubscriptionSnapshot ((State PresenceView) (Records (Vec RecordSummary)))
  SubscriptionOpened [SubscriptionToken SubscriptionSnapshot]
  SubscriptionRetracted [SubscriptionToken]
  RequestUnimplemented [UnimplementedReason]
  StateChanged [PresenceView]
  RecordCaptured [RecordSummary]

  Date [u16 u8 u8]
  Time [u8 u8 u8]
  Presence (Active Absent)
  UnimplementedReason (NotBuiltYet IntegrationNotLanded)
  PrivacyScopedRecordIdentifierQuery [PrivacySelection RecordIdentifierQuery]
  Observation (State (Records PublicRecordQuery) (PrivateRecords PrivacyScopedRecordQuery) (RecordIdentifiers RecordIdentifierQuery) (PrivateRecordIdentifiers PrivacyScopedRecordIdentifierQuery) Topics Questions)
  Subscription (State (Records RecordSubscription) (PrivateRecords PrivacyScopedRecordSubscription))
  SubscriptionToken ((State StateSubscriptionToken) (Records RecordSubscriptionToken))
  OperationKind (State Record Observe Watch Unwatch Remove ChangeCertainty CollectRemovalCandidates Tap Untap)
  OperationReceived [OperationKind]
  EffectEmitted [SemaObservation]
}

[
  (Reply
    RecordAccepted
    RecordRemoved
    StateObserved
    RecordsObserved
    RecordProvenancesObserved
    TopicsObserved
    QuestionsObserved
    SubscriptionOpened
    SubscriptionRetracted
    RequestUnimplemented
    CertaintyChanged
    RemovalCandidatesCollected)

  (Event (belongs DomainStream)
    StateChanged
    RecordCaptured)

  (Observable
    (filter default)
    (operation_event OperationReceived)
    (effect_event EffectEmitted))
]
